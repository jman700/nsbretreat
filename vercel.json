{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/",
      "permanent": false
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/",
      "permanent": false
    },
    {
      "source": "/guide",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/guide",
      "permanent": false
    },
    {
      "source": "/guide/",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/guide",
      "permanent": false
    },
    {
      "source": "/guide/index.html",
      "has": [
        {
          "type": "host",
          "value": "pad.nsbretreat.com"
        }
      ],
      "destination": "https://nsbretreat.com/guide",
      "permanent": false
    },
    {
      "source": "/guest/:token",
      "destination": "/guest?t=:token",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/ical",
      "destination": "/api/ical.js"
    },
    {
      "source": "/api/ical-vrbo",
      "destination": "/api/ical-vrbo.js"
    }
  ],
  "crons": [
    {
      "path": "/api/pool-health",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/pool-health.js": {
      "maxDuration": 60
    },
    "api/pool-status.js": {
      "maxDuration": 30
    }
  }
}
